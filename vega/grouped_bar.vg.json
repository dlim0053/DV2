{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Threatened animals by group and status",
    "subtitle": [
      "Source: DCCEEW threatened species list, extracted 28 August 2026. Species not yet extinct.",
      "All habitats, not only wetlands. Plants and conservation-dependent species are not shown."
    ],
    "anchor": "start",
    "font": "Young Serif",
    "fontSize": 16,
    "fontWeight": 400,
    "subtitleFontSize": 12
  },
  "width": 540,
  "height": 280,
  "data": {
    "url": "data/threatened_group_status.csv"
  },
  "transform": [
    {
      "filter": "datum.group != 'Plants' && datum.status != 'Conservation Dependent'"
    }
  ],
  "encoding": {
    "x": {
      "field": "group",
      "type": "nominal",
      "title": null,
      "sort": {
        "field": "species",
        "op": "sum",
        "order": "descending"
      },
      "axis": {
        "labelAngle": 0,
        "labelFontSize": 12,
        "labelLimit": 220,
        "ticks": false
      }
    },
    "xOffset": {
      "field": "status",
      "type": "nominal",
      "sort": [
        "Critically Endangered",
        "Endangered",
        "Vulnerable"
      ]
    },
    "y": {
      "field": "species",
      "type": "quantitative",
      "title": "Number of species"
    },
    "color": {
      "field": "status",
      "type": "nominal",
      "scale": {
        "domain": [
          "Critically Endangered",
          "Endangered",
          "Vulnerable"
        ],
        "range": [
          "#b23a2e",
          "#e07b2a",
          "#e0b13a"
        ]
      },
      "legend": {
        "title": "Status",
        "orient": "top",
        "direction": "horizontal",
        "titleOrient": "left",
        "symbolSize": 140,
        "labelLimit": 220
      }
    }
  },
  "layer": [
    {
      "mark": "bar",
      "encoding": {
        "tooltip": [
          {
            "field": "group",
            "type": "nominal",
            "title": "Group"
          },
          {
            "field": "status",
            "type": "nominal",
            "title": "Status"
          },
          {
            "field": "species",
            "type": "quantitative",
            "title": "Species"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "bottom",
        "dy": -3,
        "fontSize": 10
      },
      "encoding": {
        "text": {
          "field": "species",
          "type": "quantitative"
        },
        "color": {
          "value": "#10303a"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Instrument Sans"
  }
}